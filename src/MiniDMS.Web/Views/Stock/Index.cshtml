@using MiniDMS.Models.Entities
@model List<StockBalance>
@{
    ViewData["Title"] = "Tồn kho";
    var lowCount = Model.Count(b => b.IsLowStock);
}

@if (lowCount > 0)
{
    <div class="alert alert-low-stock d-flex align-items-center mb-3">
        <i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>
        <span><strong>@lowCount sản phẩm</strong> tồn kho thấp hơn ngưỡng cảnh báo</span>
    </div>
}

<!-- Filter bar -->
<form method="get" class="card card-body mb-3 py-2">
    <div class="row g-2 align-items-end">
        <div class="col-md-4">
            <input type="text" name="sku" class="form-control form-control-sm" placeholder="Tìm SKU / tên sản phẩm..."
                   value="@ViewBag.Filter?.sku" />
        </div>
        <div class="col-md-3">
            <select name="categoryId" class="form-select form-select-sm">
                <option value="">— Tất cả danh mục —</option>
                @foreach (var cat in (List<MiniDMS.Models.Entities.ProductCategory>)ViewBag.Categories)
                {
                    <option value="@cat.Id" selected="@(ViewBag.Filter?.categoryId == cat.Id)">@cat.Name</option>
                }
            </select>
        </div>
        <div class="col-md-auto">
            <button class="btn btn-primary btn-sm"><i class="bi bi-search me-1"></i>Lọc</button>
            <a href="/Stock" class="btn btn-outline-secondary btn-sm ms-1">Reset</a>
        </div>
        <div class="col-md-auto ms-auto">
            <a href="/Stock/ExportBalance" class="btn btn-outline-success btn-sm">
                <i class="bi bi-file-earmark-excel me-1"></i>Export Excel
            </a>
            <a href="/Stock/In" class="btn btn-primary btn-sm ms-1">
                <i class="bi bi-plus-lg me-1"></i>Nhập kho
            </a>
        </div>
    </div>
</form>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th class="ps-3">SKU</th>
                    <th>Tên sản phẩm</th>
                    <th>Danh mục</th>
                    <th class="text-end">Nhập</th>
                    <th class="text-end">Xuất</th>
                    <th class="text-end">Tồn</th>
                    <th class="text-center">Trạng thái</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model)
                {
                    <tr class="@(b.IsLowStock ? "table-warning" : "")">
                        <td class="ps-3"><code>@b.SKU</code></td>
                        <td>@b.ProductName</td>
                        <td><span class="badge bg-light text-dark">@b.Category</span></td>
                        <td class="text-end text-success">@b.TotalIn.ToString("N0")</td>
                        <td class="text-end text-danger">@b.TotalOut.ToString("N0")</td>
                        <td class="text-end fw-bold @(b.IsLowStock ? "text-danger" : "")">
                            @b.Balance.ToString("N0") @b.Unit
                        </td>
                        <td class="text-center">
                            @if (b.IsLowStock)
                            { <span class="badge" style="background:#FEF3C7;color:#92400E"><i class="bi bi-exclamation-triangle"></i> Thấp</span> }
                            else
                            { <span class="badge" style="background:#D1FAE5;color:#065F46"><i class="bi bi-check-circle"></i> Đủ</span> }
                        </td>
                        <td>
                            <a href="/Stock/History/@b.ProductId" class="btn btn-outline-secondary btn-sm">Lịch sử</a>
                            <a href="/Stock/Out?productId=@b.ProductId" class="btn btn-outline-danger btn-sm ms-1">Xuất</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="card-footer text-muted" style="font-size:12px">
        Tổng: <strong>@Model.Count</strong> SKU | Tồn thấp: <strong class="text-danger">@lowCount</strong>
    </div>
</div>
