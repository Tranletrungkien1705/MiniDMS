@using MiniDMS.Services
@model DashboardSummary
@{
    ViewData["Title"] = "Dashboard";
}

<style>
    .stat { position:relative; border:none; border-radius:14px; overflow:hidden;
        box-shadow:0 1px 3px rgba(2,6,23,.08); transition:transform .15s ease, box-shadow .15s ease; }
    .stat:hover { transform:translateY(-3px); box-shadow:0 12px 28px rgba(2,6,23,.14); }
    .stat::before { content:""; position:absolute; inset:0 auto 0 0; width:4px; background:var(--c); }
    .stat .ico { width:46px; height:46px; border-radius:12px; display:flex; align-items:center; justify-content:center;
        font-size:22px; color:var(--c); background:color-mix(in srgb, var(--c) 14%, #fff); }
    .stat .lbl { font-size:11.5px; text-transform:uppercase; letter-spacing:1px; color:#94A3B8; font-weight:600; }
    .stat .num { font-size:30px; font-weight:800; line-height:1.1; letter-spacing:-.02em; }
    .stat .hint { font-size:12px; color:#94A3B8; }
</style>
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card stat h-100" style="--c:#E8620A">
            <div class="card-body d-flex align-items-start justify-content-between">
                <div><div class="lbl mb-1">Sản phẩm</div>
                    <div class="num">@Model.TotalProducts</div>
                    <div class="hint">SKU đang hoạt động</div></div>
                <div class="ico"><i class="bi bi-tags-fill"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat h-100" style="--c:#EF4444">
            <div class="card-body d-flex align-items-start justify-content-between">
                <div><div class="lbl mb-1">Tồn kho thấp</div>
                    <div class="num" style="color:#EF4444">@Model.LowStockCount</div>
                    <div class="hint">SKU cần nhập thêm</div></div>
                <div class="ico"><i class="bi bi-exclamation-triangle-fill"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat h-100" style="--c:#10B981">
            <div class="card-body d-flex align-items-start justify-content-between">
                <div><div class="lbl mb-1">Doanh thu hôm nay</div>
                    <div class="num" style="color:#10B981;font-size:23px">@Model.TodayRevenue.ToString("N0") ₫</div>
                    <div class="hint">Đơn đã xác nhận</div></div>
                <div class="ico"><i class="bi bi-cash-stack"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat h-100" style="--c:#F59E0B">
            <div class="card-body d-flex align-items-start justify-content-between">
                <div><div class="lbl mb-1">Đơn chờ xử lý</div>
                    <div class="num" style="color:#F59E0B">@Model.PendingOrders</div>
                    <div class="hint">Cần xác nhận</div></div>
                <div class="ico"><i class="bi bi-hourglass-split"></i></div>
            </div>
        </div>
    </div>
</div>

<!-- Monthly sales chart -->
<div class="row g-3">
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                <h6 class="fw-600 mb-3">Doanh thu 6 tháng gần nhất</h6>
                <canvas id="salesChart" height="80"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="fw-600 mb-3">Thao tác nhanh</h6>
                <div class="d-grid gap-2">
                    <a href="/Stock/In"     class="btn btn-primary"><i class="bi bi-box-arrow-in-down me-2"></i>Nhập kho</a>
                    <a href="/Stock/Out"    class="btn btn-outline-primary"><i class="bi bi-box-arrow-up me-2"></i>Xuất kho</a>
                    <a href="/Stock/Import" class="btn btn-outline-success"><i class="bi bi-file-earmark-excel me-2"></i>Import Excel</a>
                    <a href="/Order"        class="btn btn-outline-secondary"><i class="bi bi-cart3 me-2"></i>Tạo đơn hàng</a>
                    <a href="/Report/Debt"  class="btn btn-outline-danger"><i class="bi bi-cash-stack me-2"></i>Báo cáo công nợ</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
const ctx = document.getElementById('salesChart');
new Chart(ctx, {
    type: 'bar',
    data: {
        labels: [@Html.Raw(string.Join(",", Model.MonthlySales.Select(m => $"'{m.Label}'")))],
        datasets: [{
            label: 'Doanh thu (₫)',
            data: [@string.Join(",", Model.MonthlySales.Select(m => m.Value))],
            backgroundColor: 'rgba(232,98,10,0.75)',
            borderRadius: 4
        }]
    },
    options: {
        responsive: true,
        plugins: { legend: { display: false } },
        scales: {
            y: { ticks: { callback: v => (v/1000000).toFixed(1) + 'M' } }
        }
    }
});
</script>
}
