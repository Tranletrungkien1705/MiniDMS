@{
    Layout = null;
    ViewData["Title"] = "Đăng nhập";
}
<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
<title>Đăng nhập — MiniDMS</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
<style>
  body { background:
      radial-gradient(800px 460px at 50% -10%, rgba(232,98,10,.20), transparent 60%),
      radial-gradient(900px 520px at 50% 120%, rgba(28,45,80,.55), transparent 60%), #12192D;
    min-height: 100vh; display: flex; align-items: center; justify-content: center;
    font-family: "Be Vietnam Pro", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    -webkit-font-smoothing: antialiased; }
  .login-box { background: #fff; border-radius: 14px; padding: 40px 36px; width: 360px; box-shadow: 0 20px 60px rgba(0,0,0,.45); }
  .brand { font-size: 28px; font-weight: 800; color: #12192D; }
  .brand span { color: #E8620A; }
  .btn-login { background: #E8620A; color: #fff; border: none; padding: 10px; font-weight: 600; }
  .btn-login:hover { background: #c8540a; color: #fff; }
  .demo-accounts { font-size: 12px; background: #F5F7FA; border-radius: 6px; padding: 10px 12px; }
</style>
</head>
<body>
<div class="login-box">
  <div class="brand mb-1">Mini<span>DMS</span></div>
  <p class="text-muted mb-4" style="font-size:13px">Hệ thống quản lý bán hàng & kho</p>

  <form method="post" action="/Account/Login">
    @Html.AntiForgeryToken()
    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
    @if (!ViewData.ModelState.IsValid)
    { <div class="alert alert-danger py-2 px-3 mb-3" style="font-size:13px">Email hoặc mật khẩu không đúng.</div> }

    <div class="mb-3">
      <label class="form-label fw-600">Email</label>
      <input type="email" name="email" class="form-control" placeholder="email@minidms.com" required autofocus />
    </div>
    <div class="mb-4">
      <label class="form-label fw-600">Mật khẩu</label>
      <input type="password" name="password" class="form-control" placeholder="••••••••" required />
    </div>
    <button type="submit" class="btn btn-login w-100">Đăng nhập</button>
  </form>

  <div class="demo-accounts mt-4">
    <div class="fw-600 mb-1" style="font-size:11px;text-transform:uppercase;letter-spacing:1px;color:#6B7280">Tài khoản demo</div>
    <div><code>admin@minidms.com</code> / <code>Admin@123</code> <span class="badge" style="background:#E8620A;font-size:10px">Admin</span></div>
    <div><code>warehouse@minidms.com</code> / <code>Kho@123</code></div>
    <div><code>sales@minidms.com</code> / <code>Sales@123</code></div>
    <div><code>accounting@minidms.com</code> / <code>Acc@123</code></div>
  </div>
</div>
</body>
</html>
