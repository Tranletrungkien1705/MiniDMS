@using MiniDMS.Models.Entities
@model IEnumerable<Product>
@{
    ViewData["Title"] = "Sản phẩm";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h5 class="mb-0 fw-bold">
            <i class="bi bi-box-seam me-2"></i>Sản phẩm
        </h5>
        <small class="text-muted">@Model.Count() sản phẩm</small>
    </div>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i>Thêm sản phẩm
        </a>
    }
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th>SKU</th>
                    <th>Tên sản phẩm</th>
                    <th>Danh mục</th>
                    <th class="text-end">Giá vốn</th>
                    <th class="text-end">Giá bán</th>
                    <th class="text-center">Đơn vị</th>
                    <th class="text-center">Trạng thái</th>
                    @if (User.IsInRole("Admin"))
                    {
                        <th class="text-center">Thao tác</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">
                            <i class="bi bi-inbox fs-4 d-block mb-2"></i>
                            Chưa có sản phẩm nào
                        </td>
                    </tr>
                }
                @foreach (var p in Model)
                {
                    <tr class="@(p.IsActive ? "" : "table-secondary text-muted")">
                        <td class="font-monospace fw-semibold small">@p.SKU</td>
                        <td>
                            <div class="fw-semibold">@p.Name</div>
                            @if (p.LowStockThreshold > 0)
                            {
                                <small class="text-muted">Cảnh báo dưới @p.LowStockThreshold</small>
                            }
                        </td>
                        <td>
                            <span class="badge bg-secondary fw-normal">@p.Category?.Name</span>
                        </td>
                        <td class="text-end font-monospace small">
                            @p.CostPrice.ToString("N0") ₫
                        </td>
                        <td class="text-end font-monospace small">
                            @p.SalePrice.ToString("N0") ₫
                        </td>
                        <td class="text-center small">@p.Unit</td>
                        <td class="text-center">
                            @if (p.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle">Đang bán</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Ngừng</span>
                            }
                        </td>
                        @if (User.IsInRole("Admin"))
                        {
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@p.Id"
                                       class="btn btn-outline-primary" title="Sửa">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    @if (p.IsActive)
                                    {
                                        <form asp-action="Deactivate" asp-route-id="@p.Id" method="post"
                                              onsubmit="return confirm('Ngừng bán sản phẩm này?')">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger" title="Ngừng bán">
                                                <i class="bi bi-x-circle"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
