@using MiniDMS.Models.Entities
@model Product
@{
    var isEdit = Model?.Id > 0;
    ViewData["Title"] = isEdit ? "Sửa sản phẩm" : "Thêm sản phẩm";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h5 class="mb-0 fw-bold">
            <i class="bi bi-@(isEdit ? "pencil" : "plus-circle") me-2"></i>@ViewData["Title"]
        </h5>
        <small class="text-muted">@(isEdit ? $"SKU: {Model?.SKU}" : "Điền thông tin sản phẩm mới")</small>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Quay lại
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="@(isEdit ? "Edit" : "Create")" method="post">
                    @Html.AntiForgeryToken()
                    @if (isEdit)
                    {
                        <input type="hidden" asp-for="Id" />
                    }

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">
                                SKU <span class="text-danger">*</span>
                            </label>
                            <input asp-for="SKU" class="form-control font-monospace"
                                   placeholder="VD: TS-001" maxlength="30" required
                                   @(isEdit ? "readonly" : "") />
                            <span asp-validation-for="SKU" class="text-danger small"></span>
                            @if (isEdit)
                            {
                                <div class="form-text">SKU không thể thay đổi</div>
                            }
                        </div>
                        <div class="col-md-8">
                            <label class="form-label fw-semibold">
                                Tên sản phẩm <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Name" class="form-control"
                                   placeholder="VD: Áo thun basic unisex" maxlength="200" required />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">
                                Danh mục <span class="text-danger">*</span>
                            </label>
                            <select asp-for="CategoryId" class="form-select"
                                    asp-items="@(ViewBag.Categories as Microsoft.AspNetCore.Mvc.Rendering.SelectList)" required>
                                <option value="">-- Chọn danh mục --</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Đơn vị</label>
                            <input asp-for="Unit" class="form-control" placeholder="cái, chiếc, bộ..." maxlength="20" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Cảnh báo tồn thấp</label>
                            <input asp-for="LowStockThreshold" type="number" class="form-control"
                                   min="0" step="1" placeholder="0" />
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">
                                Giá vốn (₫) <span class="text-danger">*</span>
                            </label>
                            <input asp-for="CostPrice" type="number" class="form-control font-monospace"
                                   min="0" step="1000" required placeholder="0" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">
                                Giá bán (₫) <span class="text-danger">*</span>
                            </label>
                            <input asp-for="SalePrice" type="number" class="form-control font-monospace"
                                   min="0" step="1000" required placeholder="0" />
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle me-1"></i>
                            @(isEdit ? "Lưu thay đổi" : "Thêm sản phẩm")
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
