@using MiniDMS.Models.Entities
@model CarSpec
@{ ViewData["Title"] = "Sửa phiên bản xe"; }

@* Nhãn xuất xứ BẮT BUỘC — port 1:1 Update (MstCarSpecController.cs:1969), bảng Mst_CarSpec *@
<h1 class="h5 mb-3 fw-bold">
    <i class="bi bi-car-front me-2"></i>Sửa phiên bản xe @Model.SpecCode
    <span class="text-muted fw-normal" style="font-size:13px">(port 1:1 MstCarSpecController — Mst_CarSpec)</span>
</h1>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(false, "", new { @class = "alert alert-danger py-2 small" })
    <partial name="_Form" model="Model" />
    <div class="d-flex gap-2 mb-4">
        <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-check-lg me-1"></i>Cập nhật</button>
        <a href="/CarSpec" class="btn btn-outline-secondary btn-sm">Huỷ</a>
    </div>
</form>
