@using MiniDMS.Models.Entities
@using MiniDMS.Services
@model CarSpec
@*
    Form nhập Phiên bản xe — 20 cột lưu của Mst_CarSpec.
    Nguồn cột : 12.Dev.Common/idn.DMSSales.Common/Models/DMSSales/Mst_CarSpec.cs:10-31
    Nguồn guard: MstCarSpecController.cs:1702-1888
*@
@{ var isEdit = Model.Id != 0; }

<input type="hidden" asp-for="Id" />
@if (isEdit) { <input type="hidden" asp-for="SpecCode" /> }

<div class="card shadow-sm mb-3">
    <div class="card-header bg-white fw-semibold small text-uppercase text-muted">
        Định danh spec — tất cả đều bắt buộc (MstCarSpecController.cs:1702-1785)
    </div>
    <div class="card-body row g-3">
        <div class="col-md-3">
            <label class="form-label small">Mã Spec *</label>
            @* :1702 — khoá nghiệp vụ, không cho đổi khi sửa *@
            <input asp-for="SpecCode" class="form-control form-control-sm" readonly="@isEdit" />
        </div>
        <div class="col-md-5">
            <label class="form-label small">Mô tả Spec *</label>
            @* :1785 *@
            <input asp-for="SpecDescription" class="form-control form-control-sm" />
        </div>
        <div class="col-md-2">
            <label class="form-label small">Mã Model *</label>
            @* :1725 *@
            <input asp-for="ModelCode" class="form-control form-control-sm" />
        </div>
        <div class="col-md-2">
            <label class="form-label small">RootSpec *</label>
            @* :1713 *@
            <input asp-for="RootSpec" class="form-control form-control-sm" />
        </div>
        <div class="col-md-2">
            <label class="form-label small">Mã Grade *</label>
            @* :1749 *@
            <input asp-for="GradeCode" class="form-control form-control-sm" />
        </div>
        <div class="col-md-2">
            <label class="form-label small">Mã OCN *</label>
            @* :1761 *@
            <input asp-for="OCNCode" class="form-control form-control-sm" />
        </div>
        <div class="col-md-2">
            <label class="form-label small">Mã StandardOption *</label>
            @* :1737 *@
            <input asp-for="StdOptCode" class="form-control form-control-sm" />
        </div>
    </div>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-header bg-white fw-semibold small text-uppercase text-muted">
        Lắp ráp &amp; ràng buộc chéo
    </div>
    <div class="card-body row g-3">
        <div class="col-md-3">
            <label class="form-label small">Trạng thái lắp ráp *</label>
            @* :1773 bắt buộc; hai giá trị nghiệp vụ nguồn dùng trong guard: CBU (:1862), CKD (:1876) *@
            <select asp-for="AssemblyStatus" class="form-select form-select-sm">
                <option value="">— chọn —</option>
                @foreach (var s in CarSpecService.AssemblyStatusValues)
                { <option value="@s">@s</option> }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small">Mã xuất xứ</label>
            @* :1862-1874 — BẮT BUỘC khi AssemblyStatus = "CBU" *@
            <input asp-for="OriginNo" class="form-control form-control-sm" />
            <small class="text-muted" style="font-size:11px">Bắt buộc nếu lắp ráp = CBU (xe nhập nguyên chiếc)</small>
        </div>
        <div class="col-md-3">
            <label class="form-label small">Cần số HĐ nhà máy *</label>
            @* :1797 chỉ '1'/'0'; :1876-1888 — CKD KHÔNG được để '0' *@
            <select asp-for="FlagInvoiceFactory" class="form-select form-select-sm">
                <option value="1">1 — Có</option><option value="0">0 — Không</option>
            </select>
            <small class="text-muted" style="font-size:11px">Phải là '1' nếu lắp ráp = CKD</small>
        </div>
        <div class="col-md-3">
            <label class="form-label small">Xe cứu thương *</label>
            @* :1810 *@
            <select asp-for="FlagAmbulance" class="form-select form-select-sm">
                <option value="1">1 — Có</option><option value="0">0 — Không</option>
            </select>
        </div>
    </div>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-header bg-white fw-semibold small text-uppercase text-muted">Thông số &amp; giá</div>
    <div class="card-body row g-3">
        <div class="col-md-2">
            <label class="form-label small">Số chỗ ngồi</label>
            @* :1823 *@
            <input asp-for="NumberOfSeats" type="number" min="1" class="form-control form-control-sm" />
        </div>
        <div class="col-md-3">
            <label class="form-label small">Đơn giá</label>
            <input asp-for="UnitPrice" type="number" step="0.01" class="form-control form-control-sm" />
        </div>
        <div class="col-md-3">
            <label class="form-label small">Ngày tính Quota map VIN</label>
            <input asp-for="QuotaDate" type="date" class="form-control form-control-sm" />
        </div>
        <div class="col-md-2">
            <label class="form-label small">Tính TTC theo ngày bán lẻ *</label>
            @* :1836 *@
            <select asp-for="FlagDepositPmt" class="form-select form-select-sm">
                <option value="1">1 — Có</option><option value="0">0 — Không</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small">Trạng thái *</label>
            @* :1849 *@
            <select asp-for="FlagActive" class="form-select form-select-sm">
                <option value="1">1 — Hoạt động</option><option value="0">0 — Ngừng</option>
            </select>
        </div>
        <div class="col-md-12">
            <label class="form-label small">Ghi chú</label>
            <input asp-for="Remark" class="form-control form-control-sm" />
        </div>
    </div>
</div>
