@using MiniDMS.Services
@model IEnumerable<DebtRow>
@{
    ViewData["Title"] = "Báo cáo Công nợ";
    var totalDebt = Model.Sum(r => r.Debt);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h5 class="mb-0 fw-bold">
            <i class="bi bi-credit-card me-2"></i>Công nợ Khách hàng
        </h5>
        <small class="text-muted">@Model.Count() khách hàng có công nợ</small>
    </div>
    <a asp-action="ExportDebt" class="btn btn-success btn-sm">
        <i class="bi bi-file-earmark-excel me-1"></i>Xuất Excel
    </a>
</div>

@if (totalDebt > 0)
{
    <div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-3 fs-5"></i>
        <div>
            Tổng công nợ hiện tại:
            <strong class="ms-1">@totalDebt.ToString("N0") ₫</strong>
            <span class="text-muted ms-2">(@Model.Count(r => r.Debt > 0) khách còn nợ)</span>
        </div>
    </div>
}
else
{
    <div class="alert alert-success d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-3 fs-5"></i>
        <div>Tất cả khách hàng đã thanh toán đầy đủ.</div>
    </div>
}

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th>Mã KH</th>
                    <th>Tên khách hàng</th>
                    <th class="text-end">Tổng bán (₫)</th>
                    <th class="text-end">Đã trả (₫)</th>
                    <th class="text-end">Công nợ (₫)</th>
                    <th class="text-center">Trạng thái</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            <i class="bi bi-inbox fs-4 d-block mb-2"></i>
                            Không có dữ liệu
                        </td>
                    </tr>
                }
                @foreach (var r in Model.OrderByDescending(x => x.Debt))
                {
                    <tr>
                        <td class="font-monospace fw-semibold small">@r.CustomerCode</td>
                        <td class="fw-semibold">@r.CustomerName</td>
                        <td class="text-end font-monospace text-muted">@r.TotalAmount.ToString("N0")</td>
                        <td class="text-end font-monospace text-muted">@r.PaidAmount.ToString("N0")</td>
                        <td class="text-end font-monospace @(r.Debt > 0 ? "text-danger fw-bold" : "text-muted")">
                            @r.Debt.ToString("N0")
                        </td>
                        <td class="text-center">
                            @if (r.Debt > 0)
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Còn nợ</span>
                            }
                            else
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle">Đã TT</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
            @if (Model.Any())
            {
                <tfoot class="table-light fw-bold">
                    <tr>
                        <td colspan="4" class="text-end">Tổng cộng:</td>
                        <td class="text-end font-monospace text-danger">@totalDebt.ToString("N0")</td>
                        <td></td>
                    </tr>
                </tfoot>
            }
        </table>
    </div>
</div>
