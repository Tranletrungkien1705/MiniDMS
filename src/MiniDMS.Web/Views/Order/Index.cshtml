@using MiniDMS.Models.Entities
@model IEnumerable<Order>
@{
    ViewData["Title"] = "Đơn hàng";
    var status = ViewBag.Status as OrderStatus?;
}

@functions {
    string StatusBadge(OrderStatus s) => s switch
    {
        OrderStatus.Draft     => "<span class='badge bg-secondary-subtle text-secondary border border-secondary-subtle'>Nháp</span>",
        OrderStatus.Confirmed => "<span class='badge bg-primary-subtle text-primary border border-primary-subtle'>Đã xác nhận</span>",
        OrderStatus.Delivered => "<span class='badge bg-success-subtle text-success border border-success-subtle'>Đã giao</span>",
        OrderStatus.Cancelled => "<span class='badge bg-danger-subtle text-danger border border-danger-subtle'>Đã hủy</span>",
        _ => ""
    };
    string PayBadge(PaymentStatus s) => s switch
    {
        PaymentStatus.Paid        => "<span class='badge bg-success-subtle text-success border border-success-subtle'>Đã TT</span>",
        PaymentStatus.PartialPaid => "<span class='badge bg-warning-subtle text-warning border border-warning-subtle'>TT một phần</span>",
        _ => "<span class='badge bg-danger-subtle text-danger border border-danger-subtle'>Chưa TT</span>"
    };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h5 class="mb-0 fw-bold"><i class="bi bi-cart3 me-2"></i>Đơn hàng</h5>
        <small class="text-muted">@Model.Count() đơn</small>
    </div>
    @if (User.IsInRole("Admin") || User.IsInRole("Sales"))
    {
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Tạo đơn hàng</a>
    }
</div>

<form method="get" class="card shadow-sm p-3 mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-auto">
            <label class="form-label small text-muted mb-1">Trạng thái</label>
            <select name="status" class="form-select form-select-sm">
                <option value="">Tất cả</option>
                @foreach (OrderStatus s in Enum.GetValues<OrderStatus>())
                {
                    <option value="@s" selected="@(status == s)">@s</option>
                }
            </select>
        </div>
        <div class="col-auto">
            <label class="form-label small text-muted mb-1">Từ ngày</label>
            <input type="date" name="from" value="@(((DateTime?)ViewBag.From)?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
        </div>
        <div class="col-auto">
            <label class="form-label small text-muted mb-1">Đến ngày</label>
            <input type="date" name="to" value="@(((DateTime?)ViewBag.To)?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
        </div>
        <div class="col-auto">
            <button class="btn btn-outline-primary btn-sm"><i class="bi bi-funnel me-1"></i>Lọc</button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Xóa lọc</a>
        </div>
    </div>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th>Số đơn</th>
                    <th>Khách hàng</th>
                    <th>Ngày</th>
                    <th class="text-end">Tổng tiền</th>
                    <th class="text-end">Còn nợ</th>
                    <th class="text-center">Trạng thái</th>
                    <th class="text-center">Thanh toán</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted py-4"><i class="bi bi-inbox fs-4 d-block mb-2"></i>Chưa có đơn hàng nào</td></tr>
                }
                @foreach (var o in Model)
                {
                    <tr>
                        <td class="font-monospace fw-semibold small">@o.OrderNo</td>
                        <td class="fw-semibold">@o.Customer?.Name</td>
                        <td class="small text-muted">@o.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-end font-monospace">@o.TotalAmount.ToString("N0")</td>
                        <td class="text-end font-monospace @(o.DebtAmount > 0 ? "text-danger fw-bold" : "text-muted")">@o.DebtAmount.ToString("N0")</td>
                        <td class="text-center">@Html.Raw(StatusBadge(o.Status))</td>
                        <td class="text-center">@Html.Raw(PayBadge(o.PaymentStatus))</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@o.Id" class="btn btn-sm btn-outline-primary">Chi tiết</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
