@using MiniDMS.Models.Entities
@model IEnumerable<Customer>
@{
    ViewData["Title"] = "Khách hàng";
    var search = ViewBag.Search as string;
    bool canManage = User.IsInRole("Admin") || User.IsInRole("Sales");
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h5 class="mb-0 fw-bold"><i class="bi bi-people me-2"></i>Khách hàng</h5>
        <small class="text-muted">@Model.Count() khách hàng</small>
    </div>
    @if (canManage)
    {
        <button class="btn btn-primary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#addCust">
            <i class="bi bi-person-plus me-1"></i>Thêm khách hàng
        </button>
    }
</div>

@if (canManage)
{
    <div class="collapse mb-3" id="addCust">
        <div class="card shadow-sm"><div class="card-body">
            <form asp-action="CreateCustomer" method="post" class="row g-2 align-items-end">
                @Html.AntiForgeryToken()
                <div class="col-md-3"><label class="form-label small mb-1">Tên <span class="text-danger">*</span></label>
                    <input name="name" class="form-control form-control-sm" required /></div>
                <div class="col-md-2"><label class="form-label small mb-1">Điện thoại</label>
                    <input name="phone" class="form-control form-control-sm" /></div>
                <div class="col-md-3"><label class="form-label small mb-1">Email</label>
                    <input name="email" type="email" class="form-control form-control-sm" /></div>
                <div class="col-md-3"><label class="form-label small mb-1">Địa chỉ</label>
                    <input name="address" class="form-control form-control-sm" /></div>
                <div class="col-md-1"><button class="btn btn-primary btn-sm w-100">Lưu</button></div>
            </form>
        </div></div>
    </div>
}

<form method="get" class="mb-3">
    <div class="input-group input-group-sm" style="max-width:340px">
        <input name="search" value="@search" class="form-control" placeholder="Tìm theo tên / mã KH…" />
        <button class="btn btn-outline-primary"><i class="bi bi-search"></i></button>
        @if (!string.IsNullOrEmpty(search))
        {
            <a asp-action="Customers" class="btn btn-outline-secondary">Xóa</a>
        }
    </div>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th>Mã KH</th><th>Tên</th><th>Điện thoại</th><th>Địa chỉ</th><th class="text-end">Công nợ (₫)</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-4"><i class="bi bi-inbox fs-4 d-block mb-2"></i>Không có khách hàng</td></tr>
                }
                @foreach (var c in Model)
                {
                    <tr>
                        <td class="font-monospace fw-semibold small">@c.Code</td>
                        <td class="fw-semibold">@c.Name</td>
                        <td class="small">@c.Phone</td>
                        <td class="small text-muted">@c.Address</td>
                        <td class="text-end font-monospace @(c.DebtBalance > 0 ? "text-danger fw-bold" : "text-muted")">@c.DebtBalance.ToString("N0")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
