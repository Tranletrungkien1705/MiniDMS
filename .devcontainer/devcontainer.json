{
  "name": "MiniDMS (.NET 8 + SQL Server)",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "forwardPorts": [8080, 1433],
  "portsAttributes": {
    "8080": { "label": "MiniDMS Web", "onAutoForward": "openPreview" },
    "1433": { "label": "SQL Server" }
  },
  "onCreateCommand": "dotnet restore src/MiniDMS.Web/MiniDMS.Web.csproj",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": ["ms-dotnettools.csdevkit", "ms-dotnettools.csharp", "ms-mssql.mssql"]
    }
  }
}
